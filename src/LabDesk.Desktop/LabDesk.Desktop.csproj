<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GSLab</AssemblyName>
    <RootNamespace>LabDesk.Desktop</RootNamespace>
    <!-- Same mark as the desktop shortcut, embedded so Explorer shows it on the exe. -->
    <ApplicationIcon>..\..\desktop\GSLab.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>

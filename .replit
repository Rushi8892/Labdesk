modules = ["dotnet-10.0", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "LabDesk"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 dotnet run --project src/LabDesk.Api/LabDesk.Api.csproj --artifacts-path .cache/dotnet"
waitForPort = 5000

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LabDesk"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80
